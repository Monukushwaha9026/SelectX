{
  "manifest_version": 3,
  "name": "SelectX - Instant Define & Translate",
  "version": "1.0.0",
  "description": "Instant dictionary definitions and translations on text selection with clean glassmorphic UI.",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.dictionaryapi.dev/*",
    "https://api.mymemory.translated.net/*",
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "trigger_selectx": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Trigger SelectX on selected text"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
